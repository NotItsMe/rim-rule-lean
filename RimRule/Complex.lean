import RimRule.Defs

-- This project is not part of mathlib, so the mathlib copyright-header linter does not apply.
set_option linter.style.header false

/-!
# Simplicial complexes, links and collapsibility (local obstructions)

Definitions that mirror the papers (Curto et al., arXiv 1508.00150, "What makes a neural
code convex?"; and the council part-2 note §5 "Definitions"):

* `maximal C`: the **maximal codewords** (facets) of `C`.
* `delta C`: the **simplicial complex `Δ(C)`** generated by `C`: every set contained in a
  codeword. `mem_delta_iff_maximal` shows it is also the complex generated by the maximal
  codewords, as the paper phrases it.
* `link K σ`: the **link** `lk_σ(K) = {τ ∈ K : τ ∩ σ = ∅, τ ∪ σ ∈ K}`.
* `IsFreeFace`, `elemCollapse`, `CollapsesTo`, `Collapsible`: **elementary collapses** and
  **collapsibility**. `σ` is a free face of `K` with coface `τ` if `τ` is the only face of `K`
  strictly containing `σ`, and `|τ| = |σ| + 1`. The elementary collapse removes `σ` and `τ`.
  `K` is collapsible if a finite list of elementary collapses takes it to a single vertex
  `{∅, {v}}`. The list is the certificate, so collapsibility is checked by `decide` once
  the list is given.
* `IsMaxInter C σ`: `σ` is an intersection of (a nonempty family of) maximal codewords.
* `LinksCollapsible C`: every nonempty face `σ ∈ Δ(C)` that is an intersection of maximal
  codewords and is not a codeword has a collapsible link `lk_σ(Δ(C))`.

Convention: a complex is a `Finset (Finset (Fin n))` that contains the empty face `∅`
(so `Δ(C)` contains `∅` whenever `C` is nonempty, and every link of a face contains `∅`).

## What is proved and what is cited

**Collapsible ⇒ contractible ⇒ no local obstruction is a cited textbook fact, not proved
here.**

`LinksCollapsible C` is a purely combinatorial statement, and that is all this project proves
about it. Its meaning for convexity rests on two facts that are **cited, not proved here**:
1. *Collapsible ⇒ contractible.* An elementary collapse is a deformation retraction, so a
   collapsible complex is contractible. This is a standard textbook fact of combinatorial
   topology; it is not formalized here (mathlib has no geometric realization of abstract
   simplicial complexes to state it with).
2. *Contractible links ⇒ no local obstruction* (Curto et al., arXiv 1508.00150): a code has a
   local obstruction exactly when some `σ ∈ Δ(C) ∖ C` that is a nonempty intersection of
   maximal codewords has a non-contractible link in `Δ(C)`.

So "`LinksCollapsible C` ⇒ C has no local obstruction" is a cited consequence. The Lean
theorems only establish `LinksCollapsible C` itself.
-/

namespace RimRule

open Finset

variable {n : ℕ}

/-! ### Maximal codewords and `Δ(C)` -/

/-- Paper: "Its **facets** are its maximal codewords": `c ∈ C` with no codeword strictly
above it. -/
def maximal (C : Finset (Finset (Fin n))) : Finset (Finset (Fin n)) :=
  C.filter fun c => ∀ d ∈ C, c ⊆ d → d = c

/-- Paper: "**Δ(C)** is the simplicial complex they generate": all `σ ⊆ [n]` contained in
some codeword. (`mem_delta_iff_maximal`: equivalently, in some maximal codeword.) -/
def delta (C : Finset (Finset (Fin n))) : Finset (Finset (Fin n)) :=
  univ.filter fun σ => ∃ c ∈ C, σ ⊆ c

/-- A family of sets is a **simplicial complex** if it is closed under taking subsets. -/
def IsComplex (K : Finset (Finset (Fin n))) : Prop :=
  ∀ σ ∈ K, ∀ τ ⊆ σ, τ ∈ K

theorem mem_delta {C : Finset (Finset (Fin n))} {σ : Finset (Fin n)} :
    σ ∈ delta C ↔ ∃ c ∈ C, σ ⊆ c := by
  simp [delta]

theorem isComplex_delta (C : Finset (Finset (Fin n))) : IsComplex (delta C) := by
  intro σ hσ τ hτ
  obtain ⟨c, hc, hσc⟩ := mem_delta.1 hσ
  exact mem_delta.2 ⟨c, hc, hτ.trans hσc⟩

/-- Every codeword lies under a maximal codeword. -/
theorem exists_maximal_above {C : Finset (Finset (Fin n))} {c : Finset (Fin n)} (hc : c ∈ C) :
    ∃ M ∈ maximal C, c ⊆ M := by
  classical
  obtain ⟨M, hMf, hmax⟩ := (C.filter (c ⊆ ·)).exists_max_image Finset.card
    ⟨c, mem_filter.2 ⟨hc, subset_rfl⟩⟩
  obtain ⟨hM, hcM⟩ := mem_filter.1 hMf
  refine ⟨M, mem_filter.2 ⟨hM, fun d hd hMd => ?_⟩, hcM⟩
  have hd' : d ∈ C.filter (c ⊆ ·) := mem_filter.2 ⟨hd, hcM.trans hMd⟩
  exact (eq_of_subset_of_card_le hMd (hmax d hd')).symm

/-- `Δ(C)` is the complex generated by the maximal codewords, as the paper defines it. -/
theorem mem_delta_iff_maximal {C : Finset (Finset (Fin n))} {σ : Finset (Fin n)} :
    σ ∈ delta C ↔ ∃ M ∈ maximal C, σ ⊆ M := by
  rw [mem_delta]
  constructor
  · rintro ⟨c, hc, hσc⟩
    obtain ⟨M, hM, hcM⟩ := exists_maximal_above hc
    exact ⟨M, hM, hσc.trans hcM⟩
  · rintro ⟨M, hM, hσM⟩
    exact ⟨M, (mem_filter.1 hM).1, hσM⟩

/-! ### Links -/

/-- Paper: the **link** of a face `σ` in a complex `K`,
`lk_σ(K) = {τ ∈ K : τ ∩ σ = ∅, τ ∪ σ ∈ K}`. -/
def link (K : Finset (Finset (Fin n))) (σ : Finset (Fin n)) : Finset (Finset (Fin n)) :=
  K.filter fun τ => Disjoint τ σ ∧ τ ∪ σ ∈ K

/-! ### Elementary collapses and collapsibility -/

/-- `σ` is a **free face** of `K` with coface `τ`: both are faces, `σ ⊆ τ` with
`|τ| = |σ| + 1`, and `τ` is the only face of `K` strictly containing `σ`. -/
def IsFreeFace (K : Finset (Finset (Fin n))) (σ τ : Finset (Fin n)) : Prop :=
  σ ∈ K ∧ τ ∈ K ∧ σ ⊆ τ ∧ τ.card = σ.card + 1 ∧ ∀ ρ ∈ K, σ ⊂ ρ → ρ = τ

instance (K : Finset (Finset (Fin n))) (σ τ : Finset (Fin n)) :
    Decidable (IsFreeFace K σ τ) := by
  unfold IsFreeFace; infer_instance

/-- The **elementary collapse** of `K` at the free pair `(σ, τ)`: remove `σ` and `τ`. -/
def elemCollapse (K : Finset (Finset (Fin n))) (σ τ : Finset (Fin n)) :
    Finset (Finset (Fin n)) :=
  (K.erase σ).erase τ

/-- `CollapsesTo K steps L`: performing the elementary collapses in `steps`, in order, each at
a free pair of the current complex, turns `K` into `L`. -/
def CollapsesTo : Finset (Finset (Fin n)) → List (Finset (Fin n) × Finset (Fin n)) →
    Finset (Finset (Fin n)) → Prop
  | K, [], L => K = L
  | K, (σ, τ) :: steps, L => IsFreeFace K σ τ ∧ CollapsesTo (elemCollapse K σ τ) steps L

instance decCollapsesTo : ∀ (K : Finset (Finset (Fin n)))
    (steps : List (Finset (Fin n) × Finset (Fin n))) (L : Finset (Finset (Fin n))),
    Decidable (CollapsesTo K steps L)
  | K, [], L => inferInstanceAs (Decidable (K = L))
  | K, (σ, τ) :: steps, L =>
    have := decCollapsesTo (elemCollapse K σ τ) steps L
    inferInstanceAs (Decidable (IsFreeFace K σ τ ∧ CollapsesTo (elemCollapse K σ τ) steps L))

/-- `K` is **collapsible**: some sequence of elementary collapses reduces it to a single
vertex `{∅, {v}}`. -/
def Collapsible (K : Finset (Finset (Fin n))) : Prop :=
  ∃ (steps : List (Finset (Fin n) × Finset (Fin n))) (v : Fin n),
    CollapsesTo K steps {∅, {v}}

/-! ### Collapsible links -/

/-- `σ` is an **intersection of maximal codewords**: `σ = ⋂_{M ∈ F} M` for a nonempty family
`F` of maximal codewords. -/
def IsMaxInter (C : Finset (Finset (Fin n))) (σ : Finset (Fin n)) : Prop :=
  ∃ F ⊆ maximal C, F.Nonempty ∧ F.inf id = σ

/-- **LinksCollapsible C**: every nonempty face `σ ∈ Δ(C)` that is an intersection of maximal
codewords and is not a codeword has a collapsible link `lk_σ(Δ(C))`.
(By the cited facts in the module doc, this implies C has no local obstruction.) -/
def LinksCollapsible (C : Finset (Finset (Fin n))) : Prop :=
  ∀ σ : Finset (Fin n), σ ∈ delta C → σ.Nonempty → IsMaxInter C σ → σ ∉ C →
    Collapsible (link (delta C) σ)

/-! ### Checking `LinksCollapsible` from a certificate

The link of `σ` in `Δ(C)` is computed directly from `C` (`linkDelta`, proved equal to
`link (delta C) σ`), which is much cheaper for the kernel to evaluate. A certificate is a list
of entries `(σ, steps, v)`: `steps` collapses `lk_σ(Δ(C))` to the vertex `v`. `CertOK` asks
that every nonempty non-codeword intersection of maximal codewords has an entry, and that
every entry's collapse sequence is valid. Both are decidable.

To avoid enumerating families of maximal codewords (slow in the kernel), the coverage check
uses the **hull** `hull C σ = ⋂ {M ∈ maximal C : σ ⊆ M}`: an intersection of maximal
codewords equals its hull (`hull_eq_of_isMaxInter`), so it suffices to cover every nonempty
non-codeword face `σ ∈ Δ(C)` with `hull C σ = σ`. -/

/-- `lk_σ(Δ(C))`, computed from `C`: `τ` disjoint from `σ` with `τ ∪ σ` inside a codeword. -/
def linkDelta (C : Finset (Finset (Fin n))) (σ : Finset (Fin n)) : Finset (Finset (Fin n)) :=
  univ.filter fun τ => Disjoint τ σ ∧ ∃ c ∈ C, τ ∪ σ ⊆ c

theorem link_delta_eq (C : Finset (Finset (Fin n))) (σ : Finset (Fin n)) :
    link (delta C) σ = linkDelta C σ := by
  ext τ
  simp only [link, linkDelta, mem_filter, mem_univ, true_and, mem_delta]
  constructor
  · rintro ⟨-, hd, h⟩
    exact ⟨hd, h⟩
  · rintro ⟨hd, c, hc, hτσ⟩
    exact ⟨⟨c, hc, subset_union_left.trans hτσ⟩, hd, c, hc, hτσ⟩

/-- A certificate entry: a face `σ`, a list of elementary collapses, and the final vertex. -/
abbrev LinkCert (n : ℕ) := Finset (Fin n) × List (Finset (Fin n) × Finset (Fin n)) × Fin n

/-- The **hull** of `σ`: the intersection of all maximal codewords containing `σ`. -/
def hull (C : Finset (Finset (Fin n))) (σ : Finset (Fin n)) : Finset (Fin n) :=
  univ.filter fun x => ∀ M ∈ maximal C, σ ⊆ M → x ∈ M

/-- An intersection of maximal codewords is its own hull. -/
theorem hull_eq_of_isMaxInter {C : Finset (Finset (Fin n))} {σ : Finset (Fin n)}
    (h : IsMaxInter C σ) : hull C σ = σ := by
  obtain ⟨F, hF, -, rfl⟩ := h
  ext x
  simp only [hull, mem_filter, mem_univ, true_and]
  constructor
  · intro hx
    have hle : {x} ≤ F.inf id :=
      Finset.le_inf fun M hM => singleton_subset_iff.2 (hx M (hF hM) (Finset.inf_le hM))
    exact singleton_subset_iff.1 hle
  · intro hx M _ hM
    exact hM hx

/-- The certificate covers every face that `LinksCollapsible` asks about: each nonempty
non-codeword face `σ ∈ Δ(C)` with `hull C σ = σ` (in particular, each nonempty non-codeword
intersection of maximal codewords) has an entry. -/
def CertCovers (C : Finset (Finset (Fin n))) (cert : List (LinkCert n)) : Prop :=
  ∀ σ ∈ delta C, σ.Nonempty → σ ∉ C → hull C σ = σ → ∃ e ∈ cert, e.1 = σ

/-- Every entry's collapse sequence is valid and ends at its vertex. -/
def CertValid (C : Finset (Finset (Fin n))) (cert : List (LinkCert n)) : Prop :=
  ∀ e ∈ cert, CollapsesTo (linkDelta C e.1) e.2.1 {∅, {e.2.2}}

/-- The certificate covers every face that `LinksCollapsible` asks about, and each of its
collapse sequences is valid. -/
def CertOK (C : Finset (Finset (Fin n))) (cert : List (LinkCert n)) : Prop :=
  CertCovers C cert ∧ CertValid C cert

instance (C : Finset (Finset (Fin n))) (cert : List (LinkCert n)) :
    Decidable (CertCovers C cert) := by
  unfold CertCovers; infer_instance

instance (C : Finset (Finset (Fin n))) (cert : List (LinkCert n)) :
    Decidable (CertValid C cert) := by
  unfold CertValid; infer_instance

instance (C : Finset (Finset (Fin n))) (cert : List (LinkCert n)) : Decidable (CertOK C cert) :=
  inferInstanceAs (Decidable (CertCovers C cert ∧ CertValid C cert))

theorem linksCollapsible_of_certOK {C : Finset (Finset (Fin n))} {cert : List (LinkCert n)}
    (h : CertOK C cert) : LinksCollapsible C := by
  intro σ hΔ hne hmi hnot
  obtain ⟨e, he, hσ⟩ := h.1 σ hΔ hne hnot (hull_eq_of_isMaxInter hmi)
  have := h.2 e he
  rw [hσ] at this
  rw [link_delta_eq]
  exact ⟨_, _, this⟩

end RimRule
